# Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file — it is gitignored for your safety.

# ──────────────────────────────────────────────
# MAPBOX (https://account.mapbox.com/access-tokens)
# Use a PUBLIC token (pk.*) for the runtime token.
# Use a SECRET token (sk.*) only for the Mapbox download token (build-time only).
# ──────────────────────────────────────────────
EXPO_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_public_token_here

# Download token used by EAS Build to pull the Mapbox SDK.
# Set this as an EAS Secret via: eas secret:create --name RNMAPBOX_MAPS_DOWNLOAD_TOKEN --value "sk...."
# Do NOT paste the sk. token here — keep it only in EAS Secrets.
RNMAPBOX_MAPS_DOWNLOAD_TOKEN=sk.your_mapbox_secret_download_token_here

# ──────────────────────────────────────────────
# SUPABASE (https://app.supabase.com/project/_/settings/api)
# ──────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...your_supabase_anon_key_here

# ──────────────────────────────────────────────
# REACTVISION / VIRO (https://reactvision.io)
# Set as EAS Secrets:
#   eas secret:create --name RV_API_KEY --value "rv_live_..."
#   eas secret:create --name RV_PROJECT_ID --value "your-project-uuid"
# ──────────────────────────────────────────────
RV_API_KEY=rv_live_your_reactvision_api_key_here
RV_PROJECT_ID=your-reactvision-project-uuid-here

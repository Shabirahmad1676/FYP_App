# ===========================
# SECRET & ENVIRONMENT FILES
# ===========================
.env
.env.*
.env*.local
!.env.example

# ===========================
# DEPENDENCIES
# ===========================
node_modules/

# ===========================
# EXPO
# ===========================
.expo/
dist/
web-build/
expo-env.d.ts

# ===========================
# NATIVE (generated by CNG workflow)
# ===========================
android/
ios/
.kotlin/

# ===========================
# NATIVE SIGNING & CERTS
# ===========================
*.orig.*
*.jks
*.p8
*.p12
*.key
*.pem
*.mobileprovision
*.keystore

# ===========================
# METRO BUNDLER
# ===========================
.metro-health-check*

# ===========================
# BUILD ARTIFACTS
# ===========================
build/
*.apk
*.aab
*.ipa

# ===========================
# TEST COVERAGE
# ===========================
coverage/

# ===========================
# DEBUG LOGS
# ===========================
npm-debug.*
yarn-debug.*
yarn-error.*

# ===========================
# TYPESCRIPT
# ===========================
*.tsbuildinfo

# ===========================
# macOS
# ===========================
.DS_Store
.AppleDouble
.LSOverride

# ===========================
# WINDOWS
# ===========================
Thumbs.db
ehthumbs.db
Desktop.ini

# ===========================
# EDITOR / IDE
# ===========================
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

